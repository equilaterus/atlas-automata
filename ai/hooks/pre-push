#!/usr/bin/env bash
set -euo pipefail

zero=0000000000000000000000000000000000000000
while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "$local_oid" == "$zero" ]]; then
        echo "Atlas does not delete published branches." >&2
        exit 1
    fi
    if [[ "$remote_oid" != "$zero" ]] && ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
        echo "Atlas rejects non-fast-forward and forced pushes." >&2
        exit 1
    fi
done
